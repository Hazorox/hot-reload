[sub_resource type="GDScript" id="GDScript_3t2em"]
resource_name = "bg-canvas"
script/source = "extends CanvasLayer

@onready var main_canvas = $\"../main\"
@onready var label = $Label
func _unhandled_input(event: InputEvent) -> void:
	if not ((event is InputEventKey) or (event is InputEventMouseButton) or (event is InputEventJoypadButton)): return
	await get_tree().create_timer(0.15).timeout
	layer = -50
	label.visible = false
	main_canvas.layer = 0
	main_canvas.visible = true
"

