[sub_resource type="GDScript" id="GDScript_8t61q"]
resource_name = "start label"
script/source = "extends Label

func _ready():
	var start_y := position.y
	
	var tween := create_tween().set_loops()
	
	tween.tween_property(self,\"position:y\",start_y-20.0,1.2).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(self,\"position:y\",start_y,1.2).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
"

[sub_resource type="GDScript" id="GDScript_a0du7"]
resource_name = "main"
script/source = "extends CanvasLayer

@onready var start_btn = $buttons/start
@onready var help_btn = $buttons/help
@onready var help_scene = preload(\"res://scenes/MainMenu/help.tscn\")
func _ready():
	help_btn.help_opened.connect(_on_help_opened)

func _input(event):
	if get_viewport().gui_get_focus_owner() != null:
		return
	if event.is_action_pressed(\"up\") or event.is_action_pressed(\"down\") or event.is_action_pressed(\"left\") or event.is_action_pressed(\"right\"):
		start_btn.grab_focus()
		get_viewport().set_input_as_handled()

func _on_help_opened():
	var scene = help_scene.instantiate()
	add_child(scene)
"

