[sub_resource type="GDScript" id="GDScript_nfrx5"]
resource_name = "scroll"
script/source = "extends CanvasLayer
@onready var stuff_to_animate = [$TextureRect,$text,$lore]
const diff_y := 170.0
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	for node in stuff_to_animate:
		node.position.y -= diff_y
	var tween := create_tween().set_parallel(true)
	for node in stuff_to_animate:
		tween.tween_property(node,\"position:y\",node.position.y+diff_y,0.65).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_LINEAR)

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed:
		if not $TextureRect.get_global_rect().has_point(event.global_position):
			var tween = create_tween().set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_BACK).set_parallel(true)
			for node in stuff_to_animate:
				tween.tween_property(node,\"modulate:a\",0,0.5)
			await tween.finished
			queue_free()
"

